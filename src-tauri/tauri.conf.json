{
  "$schema": "https://raw.githubusercontent.com/nicovank/tauri-v2-schema/refs/heads/main/tauri.conf.json",
  "productName": "vibe",
  "version": "1.2.0",
  "identifier": "com.vibe.desktop",
  "build": {
    "frontendDist": "../client/dist",
    "devUrl": "http://localhost:5188",
    "beforeDevCommand": "cd ../client && npm run dev",
    "beforeBuildCommand": "cd ../client && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "vibe.",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "path",
          "index": 1,
          "takesValue": true,
          "required": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
